# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# ─── Database (Docker Compose defaults) ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bridge
POSTGRES_PORT=5432

# ─── Supabase ────────────────────────────────────────────────────────────────
# Use the local Docker URL when running via docker-compose
SUPABASE_URL=http://localhost:5432
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Supported: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Model ID — can be swapped without code changes
LLM_MODEL=claude-sonnet-4-6

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (required if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Ollama (required if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Model used for generating vector embeddings
# text-embedding-3-small → 1536 dimensions (OpenAI)
# text-embedding-3-large → 3072 dimensions (OpenAI)
# nomic-embed-text       → 768  dimensions (Ollama)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─── Memory / Retrieval ──────────────────────────────────────────────────────
# Number of similar past messages to inject into context
MEMORY_TOP_K=5
# Document chunk size in characters
CHUNK_SIZE=500
# Overlap between consecutive chunks
CHUNK_OVERLAP=50
