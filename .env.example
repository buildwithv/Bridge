# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# ─── Database ────────────────────────────────────────────────────────────────
# Docker runs on port 5433 to avoid conflict with any local PostgreSQL on 5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bridge
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bridge

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Supported: groq | anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Groq (free tier at console.groq.com — recommended)
GROQ_API_KEY=your_groq_key_here

# Anthropic (alternative)
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Supported: ollama (free, local) | openai | cohere
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI embeddings (alternative)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=sk-...

# Cohere embeddings (alternative)
# EMBEDDING_PROVIDER=cohere
# EMBEDDING_MODEL=embed-english-v3.0
# COHERE_API_KEY=...

# ─── Memory / Retrieval ──────────────────────────────────────────────────────
MEMORY_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
